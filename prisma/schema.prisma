// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Dynamic Categories (replaces hardcoded enum)
model ProductCategory {
  id          String    @id @default(cuid())
  nameEn      String
  nameAr      String
  slug        String    @unique
  descEn      String?   @db.Text
  descAr      String?   @db.Text
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  displayOrder Int      @default(0)
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  nameEn      String
  nameAr      String
  descEn      String      @db.Text
  descAr      String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  comparePrice Decimal?   @db.Decimal(10, 2)
  cost        Decimal?    @db.Decimal(10, 2)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  images      String[]
  colors      String[]
  sizes       String[]
  stock       Int         @default(0)
  lowStockThreshold Int   @default(10)
  rating      Decimal     @db.Decimal(3, 2) @default(0)
  reviewCount Int         @default(0)
  featured    Boolean     @default(false)
  isActive    Boolean     @default(true)
  sku         String      @unique
  tags        String[]
  seoTitle    String?
  seoDescription String?  @db.Text
  seoKeywords String[]
  viewCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  fullName    String
  email       String
  phone       String
  address     Json
  notes       String?
  items       OrderItem[]
  subtotal    Decimal     @db.Decimal(10, 2)
  tax         Decimal     @db.Decimal(10, 2) @default(0)
  discount    Decimal     @db.Decimal(10, 2) @default(0)
  shipping    Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  paymentMethod String?
  paymentStatus String?   @default("pending")
  trackingNumber String?
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  color     String?
  size      String?
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String
  phone     String?
  address   Json?
  orders    Order[]
  totalSpent Decimal @db.Decimal(10, 2) @default(0)
  orderCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Site Settings & Configuration
model SiteSettings {
  id              String   @id @default("site_settings")
  storeName       String   @default("Life Box")
  storeNameAr     String   @default("صندوق الحياة")
  logo            String?
  favicon         String?
  primaryColor    String   @default("#3D1A6E")
  secondaryColor  String   @default("#E91E8C")
  currency        String   @default("EGP")
  currencySymbol  String   @default("£")
  taxRate         Decimal  @db.Decimal(5, 2) @default(0)
  shippingFee     Decimal  @db.Decimal(10, 2) @default(50)
  freeShippingMin Decimal? @db.Decimal(10, 2)
  maintenanceMode Boolean  @default(false)
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text
  aboutEn         String?  @db.Text
  aboutAr         String?  @db.Text
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  whatsappNumber  String?
  updatedAt       DateTime @updatedAt
}

// Banner & Visual Assets Management
model Banner {
  id          String   @id @default(cuid())
  titleEn     String?
  titleAr     String?
  descEn      String?  @db.Text
  descAr      String?  @db.Text
  image       String
  mobileImage String?
  linkUrl     String?
  linkText    String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  placement   String   @default("hero") // hero, sidebar, popup, category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Navbar & Layout Management
model NavigationItem {
  id          String   @id @default(cuid())
  labelEn     String
  labelAr     String
  url         String
  icon        String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  parentId    String?
  parent      NavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id])
  children    NavigationItem[] @relation("NavHierarchy")
  openInNewTab Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// API Integration Settings
model ApiIntegration {
  id          String   @id @default(cuid())
  name        String   @unique // stripe, paymob, fawry, whatsapp, shipping, etc.
  displayName String
  isEnabled   Boolean  @default(false)
  apiKey      String?
  apiSecret   String?
  webhookUrl  String?
  config      Json?    // Additional configuration as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Marketing & Promotional Content
model MarketingContent {
  id          String   @id @default(cuid())
  type        String   // popup, discount_banner, announcement
  titleEn     String?
  titleAr     String?
  contentEn   String?  @db.Text
  contentAr   String?  @db.Text
  image       String?
  ctaText     String?
  ctaUrl      String?
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  displayRules Json?   // Targeting rules (pages, user segments, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// SEO Management
model SeoPage {
  id          String   @id @default(cuid())
  pagePath    String   @unique // /, /products, /category/home-utilities
  titleEn     String
  titleAr     String
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  keywords    String[]
  ogImage     String?
  canonical   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Analytics & Business Intelligence
model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @unique @default(now())
  totalRevenue    Decimal  @db.Decimal(10, 2) @default(0)
  totalOrders     Int      @default(0)
  totalProducts   Int      @default(0)
  totalCustomers  Int      @default(0)
  avgOrderValue   Decimal  @db.Decimal(10, 2) @default(0)
  conversionRate  Decimal  @db.Decimal(5, 2) @default(0)
  cartAbandonment Decimal  @db.Decimal(5, 2) @default(0)
  topProducts     Json?    // Array of {productId, name, sales}
  topCategories   Json?
  regionalData    Json?    // Breakdown by region/city
  peakHours       Json?    // Hour-by-hour traffic/sales
  createdAt       DateTime @default(now())
}
